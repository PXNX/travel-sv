		"@testing-library/svelte": "5.4.2",
		"@types/leaflet": "1.9.21",
		"@vite-pwa/sveltekit": "1.1.0",
		"arctic": "3.7.0",
		"daisyui": "5.6.16",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
